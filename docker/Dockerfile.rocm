# strix-llama.cpp on ROCm (TheRock Core SDK) for Strix Halo (gfx1151).
#
# Adapted from kyuz0/amd-strix-halo-toolboxes (Dockerfile.rocm-10.0 and
# Dockerfile.rocm-10.0-strix-llama), which follows pwilkin/strix-halo install.sh.
# Changes here: the ROCm version is a build argument (10.0 or 10.1), the custom
# retained-PM4 runtime is optional (PM4=1), and the engine is pinned to a commit.
#
#   docker build -f docker/Dockerfile.rocm .   (PM4=0 builds against AMD's stock runtime instead)

ARG ROCM_VERSION=10.1

# ── build stage ──────────────────────────────────────────────────────────────
FROM registry.fedoraproject.org/fedora:44 AS builder
ARG ROCM_VERSION

RUN <<EOF
tee /etc/yum.repos.d/rocm.repo <<REPO
[amdrocm-stable]
name=ROCm ${ROCM_VERSION}
baseurl=https://stable.repo.amd.com/rocm/core/packages/rhel10/x86_64
enabled=1
priority=50
gpgcheck=1
gpgkey=https://stable.repo.amd.com/rocm/gpg/packages.gpg
REPO
EOF

RUN dnf -y --nodocs --setopt=install_weak_deps=False install \
  make gcc gcc-c++ cmake ninja-build git-core curl rsync patch which vim-common \
  libcurl-devel rdma-core-devel elfutils-libelf-devel libdrm-devel libglvnd-devel \
  libpciaccess-devel libstdc++-devel libzstd-devel numactl-devel openssl-devel \
  pciutils pkgconf-pkg-config python3 python3-devel python3-pip \
  amdrocm-core-devel${ROCM_VERSION}-gfx1151 amdrocm${ROCM_VERSION}-gfx1151 \
  && dnf clean all && rm -rf /var/cache/dnf/*

# The Core SDK installs into /opt/rocm/core-<version>; expose the usual /opt/rocm layout.
RUN <<'EOF'
set -eux
v=$(basename "$(realpath /opt/rocm/core-*)")
ln -sfn "$v" /opt/rocm/core
for d in bin include lib libexec share; do ln -sfn "$v/$d" "/opt/rocm/$d"; done
ln -sfn "$v/lib/llvm" /opt/rocm/llvm
ln -sfn "$v/lib/llvm/amdgcn" /opt/rocm/amdgcn
EOF

ENV ROCM_PATH=/opt/rocm HIP_PATH=/opt/rocm ROCM_ROOT=/opt/rocm \
  PATH=/opt/rocm/bin:/opt/rocm/core/bin:/opt/rocm/core/lib/llvm/bin:$PATH \
  LD_LIBRARY_PATH=/opt/rocm/core/lib/rocm_sysdeps/lib:/opt/rocm/core/lib

# Optional retained-PM4 ROCr + HIP runtime (pwilkin/rocm-systems). PM4=0 skips it
# and leaves an empty /opt/strix/lib, so the runtime stage is the same either way.
ARG PM4=1
ARG ROCM_SYSTEMS_REPO=https://github.com/pwilkin/rocm-systems.git
# ilintar-experiments, pinned: the branch later merged 1,933 upstream commits (c762032716), not yet measured.
ARG ROCM_SYSTEMS_REF=7dda3ac6cfe6bbe0b7f08c23a67cfa118d8641a1
RUN <<'EOF'
set -eux
mkdir -p /opt/strix/lib
: > /opt/strix/versions.txt
[ "$PM4" = 1 ] || exit 0
python3 -m venv /opt/strix/venv
/opt/strix/venv/bin/pip install --no-cache-dir 'CppHeaderParser==2.7.4'
git clone --filter=blob:none "$ROCM_SYSTEMS_REPO" /opt/strix/src/rocm-systems
git -C /opt/strix/src/rocm-systems checkout "$ROCM_SYSTEMS_REF"
export PATH=/opt/strix/venv/bin:$PATH
cmake -S /opt/strix/src/rocm-systems/projects/rocr-runtime -B /opt/strix/build/rocr -G Ninja \
  -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/strix/rocr -DCMAKE_INSTALL_LIBDIR=lib \
  -DCMAKE_PREFIX_PATH=/opt/rocm -DBUILD_SHARED_LIBS=ON
cmake --build /opt/strix/build/rocr --parallel "$(nproc)"
cmake --install /opt/strix/build/rocr
export LD_LIBRARY_PATH=/opt/strix/rocr/lib:/opt/rocm/core/lib:/opt/rocm/core/lib/llvm/lib
cmake -S /opt/strix/src/rocm-systems/projects/clr -B /opt/strix/build/hip -G Ninja \
  -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/strix/hip -DCMAKE_INSTALL_LIBDIR=lib \
  -DCMAKE_PREFIX_PATH="/opt/strix/rocr;/opt/rocm" -DCLR_BUILD_HIP=ON -DCLR_BUILD_OCL=OFF \
  -DHIP_PLATFORM=amd -DHIP_COMMON_DIR=/opt/strix/src/rocm-systems/projects/hip \
  -DHIPCC_BIN_DIR=/opt/rocm/bin -DLLVM_ROOT=/opt/rocm/lib/llvm -DClang_ROOT=/opt/rocm/lib/llvm \
  -DROCM_PATH=/opt/strix/rocr -Dhsa-runtime64_DIR=/opt/strix/rocr/lib/cmake/hsa-runtime64 \
  -DROCCLR_ENABLE_HSA=ON -DROCCLR_ENABLE_PAL=OFF -DHIP_ENABLE_ROCPROFILER_REGISTER=ON \
  -DUSE_PROF_API=ON -D__HIP_ENABLE_PCH=ON
cmake --build /opt/strix/build/hip --parallel "$(nproc)"
cmake --install /opt/strix/build/hip
# A branch that loses the retained-PM4 patch must fail the build.
grep -aq DEBUG_HIP_GRAPH_PM4 "$(find /opt/strix/hip/lib -name 'libamdhip64.so.*' -type f | head -n1)"
cp -a /opt/strix/rocr/lib/libhsa-runtime64.so* /opt/strix/hip/lib/libamdhip64.so* \
      /opt/strix/hip/lib/libhiprtc*.so* /opt/strix/lib/
printf 'rocm_systems=%s\n' "$(git -C /opt/strix/src/rocm-systems rev-parse --short HEAD)" >> /opt/strix/versions.txt
EOF

ARG LLAMA_REPO=https://github.com/halo-box/strix-llama.cpp.git
ARG LLAMA_COMMIT=bed1b8a14710d58cafd808c10f1cb52eeff1e3d5
WORKDIR /opt/llama.cpp
# Open PRs merged on top of the pinned commit, as "number:sha" pairs. The build
# fails if a PR head moved, so an image is always reproducible from its tag.
ARG LLAMA_PRS=""
RUN <<'EOF2'
set -eux
git clone --filter=blob:none "$LLAMA_REPO" . && git checkout "$LLAMA_COMMIT"
for pr in $LLAMA_PRS; do
  n=${pr%%:*}; sha=${pr#*:}
  git fetch origin "pull/$n/head:pr$n"
  case "$(git rev-parse "pr$n")" in "$sha"*) ;; *) echo "ERROR: PR $n head is not $sha"; exit 1;; esac
  git -c user.name=build -c user.email=build@localhost merge --no-edit "pr$n"
done
mkdir -p /opt/strix && printf 'prs=%s\n' "${LLAMA_PRS:-none}" >> /opt/strix/versions.txt
EOF2

COPY docker/patches/ /tmp/patches/
# The host-buffer workaround (llama.cpp #25992 / PR #25863) is applied only while
# upstream lacks it. GGML_HIP_GRAPHS + GGML_HIP_NO_VMM are what retained PM4 needs on
# gfx1151; they are harmless with the stock runtime.
RUN <<'EOF'
set -eux
p=/tmp/patches/llama-cpp-25992-rocm-host-buffer.patch
if git apply --check "$p"; then git apply "$p"
elif git apply --reverse --check "$p"; then echo "#25992 workaround already upstream"
else echo "ERROR: #25992 workaround no longer applies"; exit 1; fi
patch -p1 -N --fuzz=3 < /tmp/patches/llama-grammar.patch \
  || grep -q 'MAX_REPETITION_THRESHOLD 100000' src/llama-grammar.cpp
cmake -S . -B build -G Ninja \
  -DGGML_HIP=ON -DGGML_VULKAN=OFF -DGGML_HIP_GRAPHS=ON -DGGML_HIP_NO_VMM=ON \
  -DGGML_HIP_MMQ_MFMA=ON -DGGML_HIP_RCCL=OFF -DGGML_CUDA_FA=ON -DGGML_CUDA_FA_ALL_QUANTS=OFF \
  -DGPU_TARGETS=gfx1151 -DCMAKE_HIP_ARCHITECTURES=gfx1151 -DCMAKE_BUILD_TYPE=Release \
  -DLLAMA_BUILD_TESTS=OFF -DCMAKE_PREFIX_PATH=/opt/rocm -DROCM_PATH=/opt/rocm \
  -DHIP_PATH=/opt/rocm -DHIP_PLATFORM=amd
cmake --build build --parallel "$(nproc)"
cmake --install build
mkdir -p /usr/local/lib64
find build -type f -name 'lib*.so*' -exec cp {} /usr/local/lib64/ \;
printf 'llama_cpp=%s\nrocm=%s\npm4=%s\n' "$(git rev-parse --short HEAD)" \
  "$(basename "$(realpath /opt/rocm/core)")" "$PM4" >> /opt/strix/versions.txt
EOF

# ── runtime stage ────────────────────────────────────────────────────────────
FROM registry.fedoraproject.org/fedora-minimal:44
ARG ROCM_VERSION
ARG PM4=1

RUN <<EOF
tee /etc/yum.repos.d/rocm.repo <<REPO
[amdrocm-stable]
name=ROCm ${ROCM_VERSION}
baseurl=https://stable.repo.amd.com/rocm/core/packages/rhel10/x86_64
enabled=1
priority=50
gpgcheck=1
gpgkey=https://stable.repo.amd.com/rocm/gpg/packages.gpg
REPO
EOF

# libdrm, elfutils-libs and numactl-libs: the custom ROCr links the distribution's
# copies where AMD's links its vendored rocm_sysdeps ones.
RUN microdnf -y --nodocs --setopt=install_weak_deps=0 install \
  bash ca-certificates curl libatomic libstdc++ libgcc libgomp libibverbs \
  elfutils-libs libdrm numactl-libs procps-ng \
  amdrocm${ROCM_VERSION}-gfx1151 \
  && microdnf clean all && rm -rf /var/cache/dnf/* \
  && v=$(basename "$(realpath /opt/rocm/core-*)") \
  && ln -s "$v" /opt/rocm/core \
  && for d in bin include lib libexec share; do ln -s "$v/$d" "/opt/rocm/$d"; done \
  && ln -s "$v/lib/llvm" /opt/rocm/llvm && ln -s "$v/lib/llvm/amdgcn" /opt/rocm/amdgcn

COPY --from=builder /opt/strix /opt/strix-staged
RUN mkdir -p /opt/strix && cp -a /opt/strix-staged/lib /opt/strix-staged/versions.txt /opt/strix/ \
  && rm -rf /opt/strix-staged
COPY --from=builder /usr/local/ /usr/local/

RUN echo "/usr/local/lib" > /etc/ld.so.conf.d/local.conf \
  && echo "/usr/local/lib64" >> /etc/ld.so.conf.d/local.conf \
  && echo "/opt/rocm/core/lib" > /etc/ld.so.conf.d/rocm.conf \
  && echo "/opt/rocm/core/lib/rocm_sysdeps/lib" >> /etc/ld.so.conf.d/rocm.conf \
  && ldconfig && cat /opt/strix/versions.txt

# /opt/strix/lib leads LD_LIBRARY_PATH (empty with PM4=0). DEBUG_HIP_GRAPH_PM4 is read
# only by the custom runtime. Never set GGML_CUDA_ENABLE_UNIFIED_MEMORY: it corrupts
# output under retained PM4 (kyuz0, docs/building.md).
ENV ROCM_PATH=/opt/rocm HIP_PATH=/opt/rocm \
  PATH=/opt/rocm/bin:/opt/rocm/core/bin:/opt/rocm/core/lib/llvm/bin:$PATH \
  LD_LIBRARY_PATH=/opt/strix/lib:/opt/rocm/core/lib/rocm_sysdeps/lib:/opt/rocm/core/lib \
  HSA_OVERRIDE_GFX_VERSION=11.5.1 \
  DEBUG_HIP_GRAPH_PM4=1 \
  GPU_MAX_HW_QUEUES=1

CMD ["/bin/bash"]
